# SMS Portal for VoIP.ms: the web root of its subdomain (sms.example.com).

DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # The API.
    RewriteRule ^api/ api.php [L,QSA]

    # Pages of the app (/c/12, /settings...) are all index.html.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    <FilesMatch "\.(html|webmanifest)$">
        Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # The service worker must always be the current one.
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# API answers go out uncompressed: compression ("Optimize Website" in cPanel)
# would hold each one back until the work that follows it is done.
<Files "api.php">
    SetEnv no-gzip 1
</Files>

# PHP's error log lands next to api.php on many hosts: keep it private.
<Files "error_log">
    Require all denied
</Files>
