# SMS Portal for VoIP.ms: the web root of its subdomain (sms.example.com).

# Directives that need a module are wrapped in IfModule: on a host without
# that module, a bare one would put the whole site in error (500).

<IfModule mod_dir.c>
    DirectoryIndex index.html
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # API answers go out uncompressed: compression ("Optimize Website" in cPanel)
    # would hold each one back until the work that follows it is done. Set here,
    # once the API's address is rewritten to api.php, rather than with SetEnv,
    # which needs mod_env.
    RewriteRule ^api\.php$ - [E=no-gzip:1,L]

    # The API.
    RewriteRule ^api/ api.php [L,QSA]

    # Pages of the app (/c/12, /settings...) are all index.html.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    <FilesMatch "\.(html|webmanifest)$">
        Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # The service worker must always be the current one.
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# PHP's error log lands next to api.php on many hosts: keep it private.
<IfModule mod_authz_core.c>
    <Files "error_log">
        Require all denied
    </Files>
</IfModule>
