# Password protecting the web interface (required).
APP_PASSWORD=change-me

# VoIP.ms API credentials (optional: the setup wizard can store them instead).
# The API password is set in the VoIP.ms portal: Main Menu > SOAP & REST/JSON API.
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=

# How often to check for new messages, in seconds:
# while the app is open in a browser, and when nobody is looking.
POLL_INTERVAL_ACTIVE=10
POLL_INTERVAL_IDLE=60

# true when behind a reverse proxy that terminates HTTPS (secure cookies, real client IP).
TRUST_PROXY=false

# Where the database and media are stored (the Docker image uses /data).
# DATA_DIR=./data

# Port of the web server.
# PORT=8080

# Sample data instead of a real VoIP.ms account, to try the interface.
# DEMO_MODE=false
