{
  "name": "voip-ms-sms-portal",
  "version": "2.0.0",
  "private": true,
  "description": "A clean, modern self-hosted web interface for VoIP.ms SMS/MMS.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "php": ">=8.4"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:web": "vite",
    "build": "npm run build:web",
    "build:web": "vite build",
    "build:cpanel": "npm run build:web && node scripts/build-cpanel.mjs",
    "screenshots": "npm run build:web && tsx scripts/screenshots.ts",
    "release:prepare": "node scripts/release-prepare.mjs",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@audio/decode-amr": "1.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.50.0",
    "playwright-core": "1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
